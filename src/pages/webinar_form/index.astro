---
import SiteLayout from "../../layouts/SiteLayout.astro";
---

<SiteLayout title="ウェビナー応募 | テストサイト" description="ウェビナーへの応募フォームです。">
  <main>
    <section class="main-section">
      <div class="main-section__inner">
        <div class="webinar">
          <h1 class="webinar__heading js-furigana">ウェビナー応募フォーム</h1>
          <form id="apply-form" class="webinar__form">
            <div class="webinar__field">
              <label class="webinar__label" for="name">氏名</label>
              <input class="webinar__input" id="name" type="text" name="name" autocomplete="name" required />
            </div>
            <div class="webinar__field">
              <label class="webinar__label" for="company">会社名</label>
              <input class="webinar__input" id="company" type="text" name="company" autocomplete="organization" required />
            </div>
            <div class="webinar__field">
              <label class="webinar__label" for="e_mail">メールアドレス</label>
              <input class="webinar__input" id="e_mail" type="email" name="e_mail" autocomplete="email" required />
            </div>
            <div class="webinar__field">
              <label class="webinar__label" for="tel">電話番号</label>
              <input class="webinar__input" id="tel" type="tel" name="tel" autocomplete="tel" />
            </div>
            <div class="webinar__field">
              <label class="webinar__label" for="free">お問い合わせ内容</label>
              <textarea class="webinar__textarea" id="free" name="free"></textarea>
            </div>
            <button class="webinar__submit" type="submit">送信</button>
          </form>
          <p id="message" class="webinar__message" aria-live="polite"></p>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<script>
  const form = document.getElementById("apply-form");
  const message = document.getElementById("message");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !message) return;

    const formData = new FormData(form);
    const data = {
      name: formData.get("name"),
      company: formData.get("company"),
      e_mail: formData.get("e_mail"),
      tel: formData.get("tel"),
      free: formData.get("free"),
    };

    try {
      const res = await fetch("/api/apply", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const result = await res.json();
      if (result.success) {
        message.textContent = "送信しました";
        form.reset();
      } else {
        message.textContent = `送信に失敗しました：${result.error || ""}`;
      }
    } catch {
      message.textContent = "エラーが発生しました";
    }
  });
</script>
